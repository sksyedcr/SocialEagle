# ---- IBM watsonx.ai MaaS (OpenAI-compatible endpoint) ----
# Paste your token into .env (never commit .env).
WATSONX_TOKEN=
LLM_BASE_URL=https://maas.apps.wdc04-prod-ocp-01.cl.sec.ibm.com/models/gpt-oss-120b/v1
LLM_MODEL=gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=120
# Legacy aliases also accepted: WATSONX_BASE_URL, WATSONX_MODEL_NAME

# ---- Embeddings / chunking / retrieval ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
# Number of previous Q/A turns used to rewrite follow-up questions
HISTORY_TURNS=3

# ---- Storage / limits ----
MAX_UPLOAD_MB=50
# DOCUMENTS_DIR=documents
# VECTORSTORE_DIR=vectorstore

# ---- Frontend -> backend ----
BACKEND_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
