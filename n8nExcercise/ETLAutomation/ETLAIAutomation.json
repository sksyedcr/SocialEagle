      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "lyGIwQK780yzvq3Z",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  // 1. Grab the string output (checks standard Basic LLM Chain 'text' or 'output' field)\n  let rawText = item.json.text || item.json.output || Object.values(item.json)[0];\n\n  // 2. Clean up markdown backticks (```json ... ```) if Gemini added them\n  if (typeof rawText === 'string') {\n    rawText = rawText.replace(/^```json\\s*/i, '').replace(/```\\s*$/i, '').trim();\n    \n    // 3. Parse the string into a clean JSON object\n    try {\n      return { json: JSON.parse(rawText) };\n    } catch (error) {\n      return { json: { error: \"Failed to parse JSON\", raw: rawText } };\n    }\n  }\n\n  return { json: rawText };\n});\n"
      },
