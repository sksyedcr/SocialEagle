    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this student enrollment row and return ONLY a JSON object.\n\nRow data: {{ JSON.stringify($json) }}\n\nRules:\n- student_id: valid integer, if empty set MISSING\n- first_name: trim spaces, Title Case (Aarav)\n- last_name: trim spaces, Title Case (Sharma)\n- email: lowercase, fix @@ to @, if missing or invalid set INVALID_EMAIL\n- enrollment_date: convert to YYYY-MM-DD, if impossible date set INVALID_DATE\n- gpa: float between 0.0 and 4.0, if N/A or out of range set INVALID_GPA\n- major: Title Case, expand Mechanical Eng to Mechanical Engineering\n- status: only Active or Pending or Dropped (Unknown = Pending)\n- tuition_paid: integer only, strip $ and commas (NULL or empty = 0)\n- Ignore and remove any extra columns not listed above\n\nReturn ONLY raw JSON. No explanation. No markdown.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
